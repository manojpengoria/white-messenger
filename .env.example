# Copy to Vercel → Project → Settings → Environment Variables (or a local .env for the Express server).
# Never commit real values.

# Who receives inquiries (comma-separated for several addresses)
MAIL_TO=info@whitemessenger.com
# Sender shown on emails. With Resend, the domain must be verified in Resend.
MAIL_FROM=White Messenger <noreply@whitemessenger.com>

# Option A: Resend (recommended)
RESEND_API_KEY=

# Option B: SMTP mailbox (used only when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Cloudflare Turnstile CAPTCHA. The site key is public and is baked into pages at build time.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local testing only: log emails instead of sending them
# MAIL_DRY_RUN=1
